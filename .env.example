# ==============================================================================
# Agentic Developer Core - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials and settings.
# ==============================================================================

# --- Required API Keys & Tokens ---
# OpenRouter API Key for querying LLMs (Kimi, DeepSeek, Claude, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Personal Access Token (PAT) for authenticating PR operations
GH_PAT=your_github_pat_here
# Alternative standard GitHub Token (used if GH_PAT is empty)
GH_TOKEN=

# --- Agent & Workspace Settings ---
# Running mode: 'ci' for GitHub Actions or 'local' for local development
AGENT_MODE=local

# Relative or absolute path to the directory where agent logs should be saved
AGENT_LOG_PATH=.agent_logs

# Path to the workspace directory to inspect (defaults to current directory)
GITHUB_WORKSPACE=.

# --- Pull Request Review Settings (CI / Automation) ---
# The GitHub Pull Request number to review
PR_NUMBER=
# The specific LLM model to query for running code reviews
REVIEW_MODEL=moonshotai/kimi-k2.7-code

# --- OpenTelemetry (OTel) Tracing ---
# The service name reported in tracing spans
OTEL_SERVICE_NAME=agentic-developer-core

# Endpoint to send OpenTelemetry trace spans (e.g. Phoenix, Honeycomb, or Otel collector)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional headers for the OTLP exporter (comma-separated list of key=value pairs)
OTEL_EXPORTER_OTLP_HEADERS=

# --- SmithDB / Phoenix Platform Configuration ---
# Optional: SmithDB/Phoenix project name for tracing groupings
SMITHDB_PROJECT_NAME=default
# Optional: API key for authenticating with the SmithDB tracing dashboard
SMITHDB_API_KEY=
