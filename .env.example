# ==============================================================================
# Agentic Developer Core - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials and settings.
# ==============================================================================

# --- Required API Keys & Tokens ---
# OpenRouter API Key for querying LLMs (Kimi, DeepSeek, Claude, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Personal Access Token (PAT) for authenticating PR operations
GH_PAT=your_github_pat_here
# Alternative standard GitHub Token (used if GH_PAT is empty)
GH_TOKEN=

# --- Agent & Workspace Settings ---
# Running mode: 'ci' for GitHub Actions or 'local' for local development
AGENT_MODE=local

# Relative or absolute path to the directory where agent logs should be saved
AGENT_LOG_PATH=.agent_logs

# Path to the local workspace directory (defaults to the current directory '.')
# To develop a separate repository, set this to a path like './workspace'
GITHUB_WORKSPACE=.

# The remote GitHub repository slug (owner/repo) to poll for issues and create PRs.
# If left blank, it defaults to the orchestrator's own remote origin repository.
# Matches the standard GitHub Actions environment variable name.
GITHUB_REPOSITORY=

# --- Verification Gate (Verify phase) ---
# Command run in GITHUB_WORKSPACE to verify the worker's changes (default: make verify).
# Must match the target repository's tooling (e.g. "python -m pytest tests/" if the
# target repo has no Makefile). Executed without a shell (shlex.split), so a single
# command with arguments only — no pipes, &&, or redirects.
# WARNING: must not be left blank — an empty value breaks the Verify phase.
AGENT_VERIFY_COMMAND=make verify

# Timeout for the verification command in seconds (default: 300). Must not be blank.
AGENT_VERIFY_TIMEOUT=300

# --- GitHub Issue Label Configuration ---
# Label that marks an issue as ready to be claimed by the agent (default: agent-ready)
AGENT_LABEL_READY=agent-ready

# Label applied when the agent claims and starts working on the issue (default: agent-in-progress)
AGENT_LABEL_IN_PROGRESS=agent-in-progress

# Label applied when the agent detects the issue has open dependencies (default: agent-blocked)
AGENT_LABEL_BLOCKED=agent-blocked

# --- Merge-Node & Judge Trust (ADR-0014 / ADR-0019 / ADR-0050) ---
# GitHub login that authors the PR Review Judges' combined review. The Merge-Node
# trusts ONLY reviews authored by this user (spoofing guard). Must equal the
# owner of the JUDGE_GH_TOKEN configured in the target repository. If unset, the
# Merge-Node falls back to the orchestrator's own GitHub identity, which will
# ignore judge reviews posted under a different account (re-creating the gap).
AGENT_TRUSTED_JUDGE_USER=
# Seconds between Merge-Node polls of the target-repo PR reviews (default: 10).
AGENT_MERGE_POLL_INTERVAL=10
# Max seconds the Merge-Node polls for judge verdicts before escalating to
# recovery (default: 300). Only consulted when AGENT_JUDGE_ENABLED is unset or
# true; a target repo without the Reusable Judge Workflow installed should use
# the interim no-judge mode below instead of shrinking this value.
AGENT_MERGE_POLL_TIMEOUT=300
# Interim no-judge mode (ADR-0053): when false, the Merge-Node waits only for
# an external (human/policy) merge — no verdict parsing, no judge-trust lookup.
# Unset/true preserves judge-based blocking semantics exactly. Remove this
# once the Reusable Judge Workflow is deployed (#132).
AGENT_JUDGE_ENABLED=true
# Human-review-scale merge window in seconds for no-judge mode (default: 86400
# = 24h). Fully replaces AGENT_MERGE_POLL_TIMEOUT while AGENT_JUDGE_ENABLED is
# false. A non-positive value waits indefinitely — a human merges or aborts.
AGENT_NO_JUDGE_MERGE_TIMEOUT=86400
# Comma-separated check-name fragments identifying PR Review Judge workflow
# checks in the target repo's CI (ADR-0054). When Merge Polling sees a FAILED
# check whose name contains one of these fragments (case-insensitive substring
# match — reusable-workflow checks are named 'caller-job / called-job'), the
# failure is judge infrastructure the Worker cannot fix and the loop escalates
# to a human instead of consuming merge-fix budget. Any other failed check
# triggers a bounded merge-fix retry with the check's output as feedback.
# Default: llm-pr-review
AGENT_JUDGE_CHECK_NAMES=llm-pr-review

# --- Pull Request Review Settings (CI / Automation) ---
# The GitHub Pull Request number to review
PR_NUMBER=
# The specific LLM model to query for running code reviews
REVIEW_MODEL=moonshotai/kimi-k2.7-code

# --- Per-Node Model Routing (optional overrides for config/factory.json) ---
# General fallback for all nodes if no node-specific override is set.
# When active, provider routing is disabled for the overridden node.
AGENT_MODEL=
# Plan node override (e.g. deepseek/deepseek-v4-flash)
PLAN_MODEL=
# Test-Writer node override (e.g. moonshotai/kimi-k2.7-code)
TEST_WRITER_MODEL=
# Execute/Worker node override (e.g. moonshotai/kimi-k2.7-code)
EXECUTE_MODEL=

# --- OpenTelemetry (OTel) Tracing ---
# The service name reported in tracing spans
OTEL_SERVICE_NAME=agentic-developer-core

# Endpoint to send OpenTelemetry trace spans (e.g. Phoenix, Honeycomb, or Otel collector)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional headers for the OTLP exporter (comma-separated list of key=value pairs)
OTEL_EXPORTER_OTLP_HEADERS=

# --- SmithDB / Phoenix Platform Configuration ---
# Optional: SmithDB/Phoenix project name for tracing groupings
SMITHDB_PROJECT_NAME=default
# Optional: API key for authenticating with the SmithDB tracing dashboard
SMITHDB_API_KEY=
